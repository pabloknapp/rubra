generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Colecao {
  id     Int     @id @default(autoincrement())
  nome   String  @db.VarChar(30)
  cartas Carta[]

  @@map("colecoes")
}

model Carta {
  id        Int        @id @default(autoincrement())
  imagem    String
  pokemon   String     @db.VarChar(30)
  tipo      Tipo       @default(NORMAL)
  graduacao String     @default("OUTRO") @db.VarChar(30)
  nota      Int        @db.SmallInt
  idioma    String     @default("PORTUGUES") @db.VarChar(20)
  ano       Int        @db.SmallInt
  raridade  String     @default("COMMON") @db.VarChar(30)
  preco     Decimal    @db.Decimal(10, 2)
  destaque  Boolean    @default(true)
  colecaoId Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  colecao   Colecao    @relation(fields: [colecaoId], references: [id])
  propostas Proposta[]

  @@map("cartas")
}

model Cliente {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  nome      String     @db.VarChar(60)
  email     String     @unique @db.VarChar(40)
  senha     String     @db.VarChar(60)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  propostas Proposta[]

  @@map("clientes")
}

model Admin {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  nome      String   @db.VarChar(60)
  email     String   @unique @db.VarChar(40)
  senha     String   @db.VarChar(60)
  nivel     Int      @db.SmallInt
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("admins")
}

model Proposta {
  id        Int            @id @default(autoincrement())
  clienteId String         @db.VarChar(36)
  cartaId   Int
  descricao String         @db.VarChar(255)
  resposta  String?        @db.VarChar(255)
  status    StatusProposta @default(PENDENTE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  carta     Carta          @relation(fields: [cartaId], references: [id])
  cliente   Cliente        @relation(fields: [clienteId], references: [id])

  @@map("propostas")
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
}

enum Tipo {
  NORMAL
  FOGO
  AGUA
  ELETRICO
  GRAMA
  GELO
  LUTADOR
  VENENO
  TERRA
  VOADOR
  PSIQUICO
  INSETO
  PEDRA
  FANTASMA
  DRAGAO
  SOMBRIO
  ACO
  FADA
  ESTELAR
}
